<?xml version="1.0" encoding="UTF-8"?>
<!--
  MuleSoft Lakebase Demo - JDBC App (App 2) — Task 5 implementation

  Credential-mint REST call (discovered via databricks debug flag):
    POST https://${databricks.host}/api/2.0/postgres/credentials
    Authorization: Bearer {databricksOauthToken}
    Content-Type: application/json
    Body: { "endpoint": "projects/mulesoft-lakebase-demo/branches/production/endpoints/primary" }
    Response: { "token": "...", "expire_time": "..." }

  Password-injection technique: (b) Custom DataSource as static credential store,
  read by a DataWeave Java-interop expression in db:generic-connection password.
  LakebaseDataSource.getPassword() returns the static AtomicReference value.
  The Mule DB connector creates the HikariCP pool LAZILY on first db:select.
  The refresh-lakebase-token flow fires at startDelay=0 (immediately on startup)
  and calls java:invoke-static LakebaseDataSource.setPassword(token) before the
  first HTTP request reaches db:select. The pool is therefore created with a valid
  credential.

  Alternatives considered:
    (a) Reconnection strategy with db:generic-connection: db:generic-connection
        resolves connection-provider parameters once at config initialization.
        Reconnect retries use the same resolved value; the password cannot be
        rotated this way without a custom DataSource.
    (c) Per-request dynamic config-ref: Mule 4 CE does not support dynamic
        config-ref expressions on db:select/insert/etc; that is an EE feature.

  Port: 8082 (mule-data-api uses 8081).
-->
<mule xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:db="http://www.mulesoft.org/schema/mule/db"
      xmlns:os="http://www.mulesoft.org/schema/mule/os"
      xmlns:java="http://www.mulesoft.org/schema/mule/java"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core
          http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http
          http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/db
          http://www.mulesoft.org/schema/mule/db/current/mule-db.xsd
        http://www.mulesoft.org/schema/mule/os
          http://www.mulesoft.org/schema/mule/os/current/mule-os.xsd
        http://www.mulesoft.org/schema/mule/java
          http://www.mulesoft.org/schema/mule/java/current/mule-java.xsd">

    <!-- Load configuration properties from config.yaml (committed).
         Mule resolves ${...} and env-var references inside YAML string values,
         so databricks.client.secret = "${DATABRICKS_CLIENT_SECRET}" picks up
         the env var at runtime without committing the secret. -->
    <configuration-properties file="config.yaml"/>

    <!-- ================================================================
         HTTP Listener Config
         Exposes this Mule app on all interfaces at port 8082.
         (App 1 mule-data-api occupies 8081.)
         ================================================================ -->
    <!-- Internal container port is 8081; docker-compose maps host:8082 → container:8081.
         Both mule-data-api and mule-jdbc run in separate containers so port
         collisions between them are not possible. -->
    <http:listener-config name="HTTP_Listener">
        <http:listener-connection host="0.0.0.0" port="8081"/>
    </http:listener-config>

    <!-- ================================================================
         HTTP Request Config — Databricks workspace
         Used by the refresh-lakebase-token flow for both:
           Step 1: POST /oidc/v1/token   (OAuth client-credentials grant)
           Step 2: POST /api/2.0/postgres/credentials  (credential mint)
         ================================================================ -->
    <http:request-config name="Databricks_HTTP">
        <http:request-connection host="${databricks.host}" port="443" protocol="HTTPS"/>
    </http:request-config>

    <!-- ================================================================
         Object Store: in-memory cache for the Lakebase DB credential.
         The refresh-lakebase-token flow writes here every 45 minutes.
         persistent="false": token lives for the JVM lifetime only.
         ================================================================ -->
    <os:object-store name="TokenStore" persistent="false"/>

    <!-- ================================================================
         DB Config — Lakebase PostgreSQL Connection

         Technique (b): the password DataWeave expression calls
         LakebaseDataSource::getPassword() via Java interop. This static
         method reads from an AtomicReference populated by the refresh flow.

         The Mule DB connector creates the HikariCP pool lazily on the first
         db:select/insert/etc call. The refresh-lakebase-token scheduler fires
         with startDelay=0 so setPassword() is called before any CRUD flow
         handles its first HTTP request.

         For Task-6 rotation-after-expiry: the pool's maxLifetime should be set
         to the credential TTL so HikariCP evicts connections and re-calls
         connect(), which re-evaluates this DataWeave expression against the
         then-current AtomicReference value (updated by each scheduled refresh).
         ================================================================ -->
    <db:config name="Lakebase_DB">
        <db:generic-connection
            url="jdbc:postgresql://${pg.host}:5432/${pg.database}?sslmode=require"
            driverClassName="org.postgresql.Driver"
            user="${pg.user}"
            password="#[%dw 2.0
import java!com::example::mulesoft::lakebase::LakebaseDataSource as LDS
---
LDS::getPassword()]"/>
    </db:config>

    <!-- ================================================================
         Flow: refresh-lakebase-token
         Scheduled every 2700 seconds (45 minutes) with startDelay=0 so it
         fires immediately on startup, ensuring a valid credential is ready
         before the first HTTP request arrives and triggers db:select.

         Steps:
           1. Obtain a Databricks OAuth token via client-credentials grant.
           2. Mint a Lakebase database credential from the token.
              REST: POST /api/2.0/postgres/credentials
                    { "endpoint": "${lakebase.endpointPath}" }
              Response: { "token": "...", "expire_time": "..." }
           3. Inject the credential into LakebaseDataSource via invoke-static.
           4. Store the credential in TokenStore for diagnostic inspection.
         ================================================================ -->
    <flow name="refresh-lakebase-token">
        <scheduler>
            <scheduling-strategy>
                <fixed-frequency frequency="2700" startDelay="0" timeUnit="SECONDS"/>
            </scheduling-strategy>
        </scheduler>

        <!--
          Step 1: Obtain a Databricks OAuth token via client-credentials.
          POST https://${databricks.host}/oidc/v1/token
          Content-Type: application/x-www-form-urlencoded
          Body: grant_type=client_credentials
                client_id, client_secret (from config), scope=all-apis
          Response: { "access_token": "...", "token_type": "Bearer", "expires_in": 3600 }
        -->
        <set-payload value="#['grant_type=client_credentials&amp;client_id=' ++ p('databricks.client.id') ++ '&amp;client_secret=' ++ p('databricks.client.secret') ++ '&amp;scope=all-apis']"/>
        <http:request config-ref="Databricks_HTTP" method="POST" path="/oidc/v1/token">
            <http:headers>#[{ 'Content-Type': 'application/x-www-form-urlencoded' }]</http:headers>
        </http:request>
        <set-variable variableName="databricksAccessToken" value="#[payload.access_token]"/>

        <!--
          Step 2: Mint the Lakebase database credential.
          POST https://${databricks.host}/api/2.0/postgres/credentials
          Authorization: Bearer {databricksAccessToken}
          Content-Type: application/json
          Body: { "endpoint": "projects/mulesoft-lakebase-demo/branches/production/endpoints/primary" }
          Response: { "token": "...", "expire_time": "..." }

          REST call confirmed via databricks CLI debug output.
          SP (client_id 7a31531d-...) confirmed to receive HTTP 200.
          No additional grant was required; SP is project owner.
        -->
        <set-payload value="#[output application/json --- { endpoint: p('lakebase.endpointPath') }]"/>
        <http:request config-ref="Databricks_HTTP" method="POST" path="/api/2.0/postgres/credentials">
            <http:headers>#[{
                'Authorization': 'Bearer ' ++ vars.databricksAccessToken,
                'Content-Type': 'application/json'
            }]</http:headers>
        </http:request>
        <!-- Store token; expiry for logging only. The token itself is a long
             JWT string that Mule keeps as a lazy CursorProvider; the Binary
             coercion in java:args below forces full materialisation. -->
        <!-- Materialise the streaming HTTP JSON response into a concrete
             java.util.Map so that field access below returns java.lang.String
             values (not lazy Mule cursor types that java:invoke-static rejects). -->
        <set-payload value="#[%dw 2.0 output application/java --- payload]"/>
        <set-variable variableName="dbToken" value="#[payload.token]"/>
        <set-variable variableName="dbTokenExpiry" value="#[(payload.expire_time default 'unknown')]"/>

        <!--
          Step 3: Inject the fresh credential into LakebaseDataSource so the next
          db:generic-connection pool creation (or Task-6 pool re-connection)
          returns a valid password. java:invoke-static requires no Spring bean;
          it calls the static setPassword(String) method directly.
        -->
        <!-- setPassword accepts byte[] because Mule 4 represents large Strings
             as lazy CursorProviders; "as Binary" is the one DW coercion that
             forces full cursor materialisation before the Java module receives it. -->
        <!-- vars.dbToken is now a concrete java.lang.String (payload was
             materialised to java.util.Map above). The Java module maps the
             String value directly to setPassword(String). -->
        <!-- Java module matches args by compiled parameter name. Without the
             javac -parameters flag, the name is arg0, not "password". -->
        <java:invoke-static class="com.example.mulesoft.lakebase.LakebaseDataSource"
                            method="setPassword(String)">
            <java:args>#[{ arg0: vars.dbToken }]</java:args>
        </java:invoke-static>

        <!--
          Step 4: Store the credential in the Object Store for diagnostic inspection.
        -->
        <os:store objectStore="TokenStore" key="lakebase-pg-token">
            <os:value>#[vars.dbToken]</os:value>
        </os:store>

        <logger level="INFO" message="#['Refreshed Lakebase DB credential; expire_time=' ++ vars.dbTokenExpiry]"/>
    </flow>

    <!-- ================================================================
         Flow: list-customers
         GET /customers
         Returns all rows from demo.customers ordered by id.
         ================================================================ -->
    <flow name="list-customers">
        <http:listener config-ref="HTTP_Listener" path="/customers" allowedMethods="GET"/>
        <db:select config-ref="Lakebase_DB">
            <db:sql>SELECT id, name, email, tier, created_at FROM demo.customers ORDER BY id</db:sql>
        </db:select>
        <set-payload value="#[output application/json --- payload]"/>
    </flow>

    <!-- ================================================================
         Flow: get-customer
         GET /customers/{id}
         Returns the single row matching the given id.
         ================================================================ -->
    <flow name="get-customer">
        <http:listener config-ref="HTTP_Listener" path="/customers/{id}" allowedMethods="GET"/>
        <db:select config-ref="Lakebase_DB">
            <db:sql>SELECT id, name, email, tier, created_at FROM demo.customers WHERE id = :id</db:sql>
            <db:input-parameters>#[{ 'id': attributes.uriParams.id }]</db:input-parameters>
        </db:select>
        <set-payload value="#[output application/json --- payload]"/>
    </flow>

    <!-- ================================================================
         Flow: create-customer
         POST /customers
         Body: JSON with name, email, tier fields. Returns the created row.
         ================================================================ -->
    <flow name="create-customer">
        <http:listener config-ref="HTTP_Listener" path="/customers" allowedMethods="POST"/>
        <db:insert config-ref="Lakebase_DB">
            <db:sql>INSERT INTO demo.customers (name, email, tier) VALUES (:name, :email, :tier) RETURNING *</db:sql>
            <db:input-parameters>#[{ 'name': payload.name, 'email': payload.email, 'tier': payload.tier default 'standard' }]</db:input-parameters>
        </db:insert>
        <set-payload value="#[output application/json --- payload]"/>
    </flow>

    <!-- ================================================================
         Flow: update-customer
         PATCH /customers/{id}
         Body: JSON with tier field. Returns the updated row.
         ================================================================ -->
    <flow name="update-customer">
        <http:listener config-ref="HTTP_Listener" path="/customers/{id}" allowedMethods="PATCH"/>
        <db:update config-ref="Lakebase_DB">
            <db:sql>UPDATE demo.customers SET tier = :tier WHERE id = :id RETURNING *</db:sql>
            <db:input-parameters>#[{ 'id': attributes.uriParams.id, 'tier': payload.tier }]</db:input-parameters>
        </db:update>
        <set-payload value="#[output application/json --- payload]"/>
    </flow>

    <!-- ================================================================
         Flow: delete-customer
         DELETE /customers/{id}
         Returns 204 No Content on success (Mule default for empty payload).
         ================================================================ -->
    <flow name="delete-customer">
        <http:listener config-ref="HTTP_Listener" path="/customers/{id}" allowedMethods="DELETE"/>
        <db:delete config-ref="Lakebase_DB">
            <db:sql>DELETE FROM demo.customers WHERE id = :id</db:sql>
            <db:input-parameters>#[{ 'id': attributes.uriParams.id }]</db:input-parameters>
        </db:delete>
    </flow>

</mule>
