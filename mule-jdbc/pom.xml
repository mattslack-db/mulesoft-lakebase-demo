<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.mulesoft.lakebase</groupId>
    <artifactId>mule-jdbc</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>mule-application</packaging>

    <name>MuleSoft Lakebase Demo — JDBC App (App 2)</name>
    <description>
        Mule 4 app exposing JDBC CRUD over /customers via a direct PostgreSQL connection
        to Databricks Lakebase, with a scheduled flow that refreshes the Lakebase database
        credential (Phase-2 spike for token injection into the DB connection pool).
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
            Connector / driver versions to be reconciled at first `mvn package` in Phase 2.
            Pin these after running `mvn dependency:tree` against the resolved runtime BOM.
            Versions below are the latest stable at authoring time (Phase 3); they may need
            alignment with the Mule 4.6 runtime BOM and Anypoint connector release train.
        -->
        <mule.version>4.6.0</mule.version>
        <mule.db.connector.version>1.14.0</mule.db.connector.version>
        <mule.objectstore.connector.version>1.2.1</mule.objectstore.connector.version>
        <mule.http.connector.version>1.9.2</mule.http.connector.version>
        <mule.secure.properties.version>1.2.6</mule.secure.properties.version>
        <postgresql.driver.version>42.7.3</postgresql.driver.version>
        <mule.maven.plugin.version>4.1.1</mule.maven.plugin.version>
    </properties>

    <dependencies>
        <!-- Database Connector: db:config, db:select, db:insert, db:update, db:delete -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-db-connector</artifactId>
            <version>${mule.db.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Object Store Connector: os:object-store, os:store, os:retrieve -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-objectstore-connector</artifactId>
            <version>${mule.objectstore.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- HTTP Connector: HTTP listener (inbound) + HTTP request (outbound OAuth calls) -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>${mule.http.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!-- Secure Configuration Properties: resolves ${secure::...} placeholders at runtime -->
        <dependency>
            <groupId>com.mulesoft.modules</groupId>
            <artifactId>mule-secure-configuration-property-module</artifactId>
            <version>${mule.secure.properties.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>

        <!--
            PostgreSQL JDBC Driver.
            Must be packaged inside the Mule application (default scope = compile).
            The DB Connector's generic-connection loads this driver class:
              driverClassName="org.postgresql.Driver"
            Version reconciled at first `mvn package` in Phase 2.
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.driver.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <classifier>mule-application</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </repository>
        <repository>
            <id>anypoint-exchange-v3</id>
            <name>Anypoint Exchange V3</name>
            <url>https://maven.anypoint.mulesoft.com/api/v3/maven/</url>
            <layout>default</layout>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository</name>
            <url>https://repository.mulesoft.org/releases/</url>
            <layout>default</layout>
        </pluginRepository>
    </pluginRepositories>

</project>
