<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example.mulesoft.lakebase</groupId>
    <artifactId>mule-data-api</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>mule-application</packaging>

    <name>MuleSoft Lakebase Demo — Data API App</name>
    <description>
        Mule 4 app exposing PostgREST CRUD over /customers via the Databricks Lakebase
        Data API with OAuth 2.0 client-credentials authentication.
    </description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- CE-compatible connector versions; verified buildable in Task-1 spike -->
        <mule.version>4.4.0</mule.version>
        <mule.http.connector.version>1.7.3</mule.http.connector.version>
        <mule.maven.plugin.version>4.10.0</mule.maven.plugin.version>
    </properties>

    <dependencies>
        <!-- HTTP Connector: includes OAuth 2.0 client-credentials grant-type support -->
        <dependency>
            <groupId>org.mule.connectors</groupId>
            <artifactId>mule-http-connector</artifactId>
            <version>${mule.http.connector.version}</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <!-- OAuth module: provides the oauth namespace used by <oauth:client-credentials-grant-type>
             inside <http:authentication>. Open-source CE module (org.mule.modules). -->
        <dependency>
            <groupId>org.mule.modules</groupId>
            <artifactId>mule-oauth-module</artifactId>
            <version>1.1.7</version>
            <classifier>mule-plugin</classifier>
        </dependency>
        <!-- EE mule-secure-configuration-property-module removed (Task 2):
             secret injected via DATABRICKS_CLIENT_SECRET env var instead. -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.mule.tools.maven</groupId>
                <artifactId>mule-maven-plugin</artifactId>
                <version>${mule.maven.plugin.version}</version>
                <extensions>true</extensions>
                <configuration>
                    <classifier>mule-application</classifier>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository (public mirror)</name>
            <url>https://repository-master.mulesoft.org/nexus/content/repositories/releases/</url>
            <layout>default</layout>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>mulesoft-releases</id>
            <name>MuleSoft Releases Repository (public mirror)</name>
            <url>https://repository-master.mulesoft.org/nexus/content/repositories/releases/</url>
            <layout>default</layout>
        </pluginRepository>
    </pluginRepositories>

</project>
